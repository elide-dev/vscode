load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/bazel/bun:defs.bzl", "bun_test")

# Tests run under Bun (`bun:test`) from their sources and, as before, are not part of the tsc project.
# gazelle:exclude test

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "core",
    srcs = [
        "src/android.ts",
        "src/androidBinaryXml.ts",
        "src/androidLogcat.ts",
        "src/artifacts.ts",
        "src/buildOutput.ts",
        "src/buildTasks.ts",
        "src/commandTimeline.ts",
        "src/composeInputs.ts",
        "src/coverage.ts",
        "src/elide.ts",
        "src/errors.ts",
        "src/index.ts",
        "src/init.ts",
        "src/invocation.ts",
        "src/jdk.ts",
        "src/jvmTests.ts",
        "src/kotlinLsp.ts",
        "src/kotlinSetup.ts",
        "src/libraries.ts",
        "src/manifest.ts",
        "src/mavenVersion.ts",
        "src/model.ts",
        "src/pkl.ts",
        "src/sourceRoots.ts",
        "src/tap.ts",
        "src/timeline.ts",
        "src/version.ts",
        "src/workspace.ts",
    ],
    composite = True,
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    source_map = True,
    tsconfig = ":tsconfig",
    deps = [":node_modules/@types/node"],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [
        ":__subpackages__",
        "//packages/vscode:__pkg__",  # packages/vscode/tsconfig.json references this project
    ],
    deps = [
        ":package.json",
        "//:tsconfig_base",
    ],
)

bun_test(
    name = "test",
    size = "small",
    srcs = glob(["test/**/*.test.ts"]),
    data = glob(
        [
            "src/**/*.ts",
            "test/**",
        ],
        exclude = ["test/**/*.test.ts"],
    ),
)

js_library(
    name = "pkg",
    srcs = [
        "LICENSE",
        "package.json",
    ],
    visibility = ["//:__pkg__"],
    deps = [":core"],
)
