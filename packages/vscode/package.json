{
  "name": "elide",
  "displayName": "Elide",
  "description": "Elide build tool integration: Kotlin/Java classpath for the Kotlin LSP, build/run/test tasks, and JDWP debugging.",
  "version": "0.4.0",
  "preview": true,
  "publisher": "elide",
  "author": "Elide Technologies, Inc.",
  "license": "MIT",
  "private": true,
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0F0F0F",
    "theme": "dark"
  },
  "homepage": "https://github.com/elide-dev/vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/elide-dev/vscode.git"
  },
  "bugs": {
    "url": "https://github.com/elide-dev/vscode/issues"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Testing",
    "Other"
  ],
  "keywords": [
    "elide",
    "kotlin",
    "java",
    "jvm",
    "build",
    "build tool",
    "kotlin lsp",
    "pkl"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Syncing a project runs the workspace's Elide CLI (`elide manifest`, `elide install`, `elide classpath`), so an untrusted workspace could execute arbitrary code."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The Elide CLI, the JDK, and the generated `workspace.json` all need a real filesystem."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "JetBrains.kotlin-server"
  ],
  "activationEvents": [
    "workspaceContains:**/elide.pkl",
    "onDebugResolve:elide",
    "onTaskType:elide",
    "onView:elide.projects"
  ],
  "contributes": {
    "configuration": {
      "title": "Elide",
      "properties": {
        "elide.home": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Elide distribution root (the directory containing `bin/elide`). Empty: use `$ELIDE_HOME`, the platform install locations, then `elide` on `PATH`."
        },
        "elide.jdk.home": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "JDK home used for symbol resolution in the Kotlin LSP. Empty: `jvm.javaHome` from the manifest, then `$JAVA_HOME`, then installed JDKs (SDKMAN, /Library/Java/JavaVirtualMachines, /usr/lib/jvm, Program Files) matching `jvm.target`."
        },
        "elide.sync.onStartup": {
          "type": "boolean",
          "default": true,
          "description": "Sync Elide projects when the workspace opens."
        },
        "elide.sync.onManifestChange": {
          "type": "string",
          "enum": [
            "always",
            "prompt",
            "never"
          ],
          "default": "prompt",
          "description": "What to do when elide.pkl changes, or when the lockfile's resolved dependencies do. Rewrites of .dev/elide.lock*.bin that leave the dependencies unchanged (every elide run/test/build does one) are ignored."
        },
        "elide.kotlinLsp.writeWorkspaceJson": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Write `workspace.json` at the workspace folder root so the Kotlin LSP imports the Elide project model."
        },
        "elide.debug.adapter": {
          "type": "string",
          "enum": [
            "intellij",
            "java"
          ],
          "enumDescriptions": [
            "Attach with the Kotlin LSP's JVM debugger (JetBrains.kotlin-server).",
            "Attach with Debugger for Java (vscjava.vscode-java-debug)."
          ],
          "default": "intellij",
          "description": "Debug adapter used to attach to the JVM started by `elide run --debugger`."
        },
        "elide.debug.nativeMiMode": {
          "type": "string",
          "enum": [
            "auto",
            "gdb",
            "lldb"
          ],
          "enumDescriptions": [
            "GDB when one is available, LLDB on macOS, which ships none.",
            "Drive GDB, which is what Native Image emits DWARF for.",
            "Drive LLDB through the `lldb-mi` the C/C++ extension bundles."
          ],
          "default": "auto",
          "markdownDescription": "Machine-interface debugger the C/C++ extension drives for an `elide-native` session on a Native Image binary."
        },
        "elide.debug.miDebuggerPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "`gdb` (or `lldb-mi`) binary used by `elide-native` sessions. Empty: resolve `gdb` on `PATH`, and leave LLDB to the copy the C/C++ extension bundles."
        },
        "elide.install.classifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sources",
              "docs"
            ]
          },
          "default": [
            "sources"
          ],
          "uniqueItems": true,
          "markdownDescription": "Classifier jars installed for the manifest's declared Maven packages. `sources` lets Go to Definition open library code in the Kotlin LSP; `docs` adds javadoc jars; an empty list installs classes only. Elide's own Kotlin and JUnit jars are published without classifiers."
        },
        "elide.flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "`-f NAME[=VALUE]` build flags passed to every Elide invocation, project sync included; the manifest reads them as `build.flags`. Changing them marks the resolved project model stale."
        },
        "elide.build.options": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "array"
            ],
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "markdownDescription": "Default options for `elide build`, keyed by option name: `{ \"no-cache\": true, \"offline\": true }` runs `elide build --no-cache --offline`. `true` emits the bare flag, `false` omits it, an array repeats the option, anything else becomes `--name=value`. Tasks and launch configurations override individual keys."
        },
        "elide.run.options": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "array"
            ],
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "markdownDescription": "Default options for `elide run`, keyed by option name: `{ \"coverage\": true, \"timeout\": \"30s\" }` runs `elide run --coverage --timeout=30s`."
        },
        "elide.test.options": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "array"
            ],
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "markdownDescription": "Default options for `elide test`, keyed by option name: `{ \"bail\": 3, \"concurrency\": 4 }` runs `elide test --bail=3 --concurrency=4`. Test Explorer runs use them too, except for `reporter`, which stays `tap` because the extension parses that stream."
        },
        "elide.install.options": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "array"
            ],
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "markdownDescription": "Default options for the `elide install` task, keyed by option name. Project sync installs dependencies itself, driven by `elide.install.classifiers`."
        },
        "elide.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Run/Debug code lenses above JVM main functions and on entrypoints, scripts and artifacts in elide.pkl."
        }
      }
    },
    "commands": [
      {
        "command": "elide.sync",
        "category": "Elide",
        "title": "Sync Project(s)",
        "icon": "$(sync)"
      },
      {
        "command": "elide.showOutput",
        "category": "Elide",
        "title": "Show Output"
      },
      {
        "command": "elide.showMenu",
        "category": "Elide",
        "title": "Show Menu",
        "icon": "$(list-unordered)"
      },
      {
        "command": "elide.openWorkspaceJson",
        "category": "Elide",
        "title": "Open generated Kotlin LSP workspace"
      },
      {
        "command": "elide.runTask",
        "category": "Elide",
        "title": "Run Elide Command…",
        "icon": "$(play)"
      },
      {
        "command": "elide.newProject",
        "category": "Elide",
        "title": "New Project…",
        "icon": "$(new-folder)"
      },
      {
        "command": "elide.run",
        "category": "Elide",
        "title": "Run Entrypoint",
        "icon": "$(play)"
      },
      {
        "command": "elide.debug",
        "category": "Elide",
        "title": "Debug Entrypoint",
        "icon": "$(debug-alt)"
      },
      {
        "command": "elide.build",
        "category": "Elide",
        "title": "Build Artifact",
        "icon": "$(package)"
      },
      {
        "command": "elide.runArtifact",
        "category": "Elide",
        "title": "Run Artifact",
        "icon": "$(play)"
      },
      {
        "command": "elide.debugArtifact",
        "category": "Elide",
        "title": "Debug Artifact",
        "icon": "$(debug-alt)"
      },
      {
        "command": "elide.executeTask",
        "category": "Elide",
        "title": "Run Task",
        "icon": "$(play)"
      },
      {
        "command": "elide.openManifest",
        "category": "Elide",
        "title": "Open elide.pkl",
        "icon": "$(file-code)"
      },
      {
        "command": "elide.revealLibrary",
        "category": "Elide",
        "title": "Reveal in Finder/Explorer"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "elide.run",
          "when": "false"
        },
        {
          "command": "elide.debug",
          "when": "false"
        },
        {
          "command": "elide.build",
          "when": "false"
        },
        {
          "command": "elide.runArtifact",
          "when": "false"
        },
        {
          "command": "elide.debugArtifact",
          "when": "false"
        },
        {
          "command": "elide.executeTask",
          "when": "false"
        },
        {
          "command": "elide.revealLibrary",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "elide.sync",
          "when": "view == elide.projects",
          "group": "navigation@1"
        },
        {
          "command": "elide.runTask",
          "when": "view == elide.projects",
          "group": "navigation@2"
        },
        {
          "command": "elide.newProject",
          "when": "view == elide.projects",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "elide.run",
          "when": "view == elide.projects && viewItem == entrypoint",
          "group": "inline@1"
        },
        {
          "command": "elide.debug",
          "when": "view == elide.projects && viewItem == entrypoint",
          "group": "inline@2"
        },
        {
          "command": "elide.run",
          "when": "view == elide.projects && viewItem == script",
          "group": "inline@1"
        },
        {
          "command": "elide.executeTask",
          "when": "view == elide.projects && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "elide.executeTask",
          "when": "view == elide.projects && viewItem == buildTarget",
          "group": "inline@1"
        },
        {
          "command": "elide.executeTask",
          "when": "view == elide.projects && viewItem == buildTargetDebuggable",
          "group": "inline@1"
        },
        {
          "command": "elide.debug",
          "when": "view == elide.projects && viewItem == buildTargetDebuggable",
          "group": "inline@2"
        },
        {
          "command": "elide.runArtifact",
          "when": "view == elide.projects && viewItem == buildTargetRunnable",
          "group": "inline@1"
        },
        {
          "command": "elide.debugArtifact",
          "when": "view == elide.projects && viewItem == buildTargetRunnable",
          "group": "inline@2"
        },
        {
          "command": "elide.executeTask",
          "when": "view == elide.projects && viewItem == buildTargetRunnable",
          "group": "inline@3"
        },
        {
          "command": "elide.sync",
          "when": "view == elide.projects && viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "elide.openManifest",
          "when": "view == elide.projects && viewItem == project",
          "group": "inline@2"
        },
        {
          "command": "elide.revealLibrary",
          "when": "view == elide.projects && viewItem == library"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "elide",
          "title": "Elide",
          "icon": "media/elide.svg"
        }
      ]
    },
    "views": {
      "elide": [
        {
          "id": "elide.projects",
          "name": "Projects",
          "contextualTitle": "Elide",
          "icon": "media/elide.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "elide.projects",
        "when": "!elide.hasProjects",
        "contents": "No Elide project (`elide.pkl`) in this workspace.\n[New Project…](command:elide.newProject)\n[Open Folder](command:vscode.openFolder)\n[Elide documentation](https://docs.elide.dev)"
      }
    ],
    "problemMatchers": [
      {
        "name": "elide",
        "label": "Elide build diagnostics",
        "owner": "elide",
        "source": "elide",
        "fileLocation": [
          "search",
          {
            "include": [
              "${workspaceFolder}"
            ],
            "exclude": [
              "${workspaceFolder}/.dev",
              "${workspaceFolder}/.git",
              "${workspaceFolder}/node_modules"
            ]
          }
        ],
        "pattern": [
          {
            "regexp": "^(?:\\[\\s*[^\\]]+\\]\\s?)?(error|warning|info):\\s+(?:\\[\\w+\\]\\s*)?(?:[\\w.+-]+:\\s+)?(.*)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^In file:\\s+(?:file://)?(\\S+?)(?::(\\d+))?(?::(\\d+))?\\s*$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "elide",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "run",
              "test",
              "install"
            ],
            "description": "Elide CLI command to run."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Positional arguments after the command: build targets, test paths, or the entrypoint `elide run` runs."
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "markdownDescription": "`-f NAME[=VALUE]` build flags, added to those in `elide.flags`."
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "array"
              ],
              "items": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "markdownDescription": "CLI options for the command: `{ \"no-cache\": true, \"bail\": 3 }` becomes `--no-cache --bail=3`. `true` emits the bare flag, `false` omits it (cancelling a default from `elide.<command>.options`), an array repeats the option."
          },
          "programArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "markdownDescription": "Arguments passed after `--`: the application's own arguments for `run`, subprocess passthrough for `build` and `test`."
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Extra environment variables for the Elide process."
          },
          "project": {
            "type": "string",
            "description": "Project root relative to the workspace folder (multi-project workspaces)."
          }
        }
      }
    ],
    "breakpoints": [
      {
        "language": "kotlin"
      },
      {
        "language": "java"
      }
    ],
    "debuggers": [
      {
        "type": "elide",
        "label": "Elide",
        "languages": [
          "kotlin",
          "java"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "command": {
                "type": "string",
                "enum": [
                  "run",
                  "test",
                  "build"
                ],
                "default": "run",
                "markdownDescription": "Elide command to debug: `run` (the default), `test`, or `build` for one or more build targets."
              },
              "entrypoint": {
                "type": "string",
                "markdownDescription": "File, manifest script or entrypoint name `elide run` runs; empty lets Elide resolve `entrypoint`/`jvm.main`. Not used by `build`, which takes `targets`."
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "markdownDescription": "Build targets to debug, for `command: \"build\"`: `run`, `jvm-test`, … — `elide build --inspect` lists them."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments passed to the debugged program after `--`."
              },
              "elideArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Further positional arguments of the Elide command itself: test paths, for instance."
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "markdownDescription": "`-f NAME[=VALUE]` build flags, added to those in `elide.flags`."
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "array"
                  ],
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                },
                "markdownDescription": "CLI options for the command: `{ \"test-name-pattern\": \"MyTest\", \"no-cache\": true }` becomes `--test-name-pattern=MyTest --no-cache`. `--debugger` is always added; set `debugger` here to choose its value."
              },
              "project": {
                "type": "string",
                "description": "Project root relative to the workspace folder (multi-project workspaces)."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra environment variables for the Elide process."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "elide",
            "request": "launch",
            "name": "Elide: Run (debug)"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Elide: Run (debug)",
            "description": "Run the project's entrypoint with `elide run --debugger` and attach.",
            "body": {
              "type": "elide",
              "request": "launch",
              "name": "Elide: Run (debug)",
              "args": []
            }
          },
          {
            "label": "Elide: Test (debug)",
            "description": "Run `elide test --debugger` and attach.",
            "body": {
              "type": "elide",
              "request": "launch",
              "name": "Elide: Test (debug)",
              "command": "test",
              "options": {
                "test-name-pattern": "${1:pattern}"
              }
            }
          },
          {
            "label": "Elide: Build target (debug)",
            "description": "Run build targets with `elide build <targets> --debugger` and attach.",
            "body": {
              "type": "elide",
              "request": "launch",
              "name": "Elide: Build (debug)",
              "command": "build",
              "targets": [
                "${1|run,jvm-test|}"
              ],
              "options": {}
            }
          }
        ]
      },
      {
        "type": "elide-native",
        "label": "Elide Native Image",
        "languages": [
          "kotlin",
          "java"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "artifact": {
                "type": "string",
                "markdownDescription": "Native Image artifact to build and debug: the key of its entry in the `artifacts` block of `elide.pkl`, which is also the build target `elide build` takes."
              },
              "program": {
                "type": "string",
                "markdownDescription": "Binary to debug, when it is not the one the artifact's build writes to `.dev/artifacts/native-image/`. A relative path resolves against the project root."
              },
              "build": {
                "type": "boolean",
                "default": true,
                "markdownDescription": "Build `artifact` before debugging it. `false` debugs whatever the last build left behind."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Arguments passed to the debugged program."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the debugged program; defaults to the project root."
              },
              "stopAtEntry": {
                "type": "boolean",
                "default": false,
                "description": "Break on the image's entry point instead of running to the first breakpoint."
              },
              "project": {
                "type": "string",
                "description": "Project root relative to the workspace folder (multi-project workspaces)."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra environment variables for the debugged program."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "elide-native",
            "request": "launch",
            "name": "Elide: Debug Native Image",
            "artifact": ""
          }
        ],
        "configurationSnippets": [
          {
            "label": "Elide: Native Image (debug)",
            "description": "Build a Native Image artifact and debug the binary it produced with GDB.",
            "body": {
              "type": "elide-native",
              "request": "launch",
              "name": "Elide: Debug Native Image",
              "artifact": "${1:artifact}",
              "args": []
            }
          }
        ]
      }
    ],
    "walkthroughs": [
      {
        "id": "elide.gettingStarted",
        "title": "Get started with Elide",
        "description": "Build, run, test and debug Kotlin/JVM projects with the Elide build tool.",
        "steps": [
          {
            "id": "install",
            "title": "Install Elide",
            "description": "The extension drives the `elide` CLI, so Elide 1.5+ must be installed.\n[Installation docs](https://docs.elide.dev/installation)\n[Set elide.home](command:workbench.action.openSettings?%22elide.home%22)",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onSettingChanged:elide.home"
            ]
          },
          {
            "id": "project",
            "title": "Open or create a project",
            "description": "A project is a folder with an `elide.pkl` manifest.\n[New Project…](command:elide.newProject)\n[Open Folder](command:vscode.openFolder)",
            "media": {
              "markdown": "media/walkthrough/project.md"
            },
            "completionEvents": [
              "onContext:elide.hasProjects"
            ]
          },
          {
            "id": "sync",
            "title": "Sync with the Kotlin LSP",
            "description": "Syncing writes `workspace.json` so the Kotlin LSP resolves your sources and dependencies.\n[Sync now](command:elide.sync)",
            "media": {
              "markdown": "media/walkthrough/sync.md"
            },
            "completionEvents": [
              "onCommand:elide.sync"
            ]
          },
          {
            "id": "run",
            "title": "Run and debug",
            "description": "Code lenses run or debug a `main` function and the targets of `elide.pkl`.\n[Run Elide Command…](command:elide.runTask)",
            "media": {
              "markdown": "media/walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:elide.run"
            ]
          },
          {
            "id": "test",
            "title": "Run tests",
            "description": "JUnit tests appear in the Testing view and run through `elide test`.\n[Open Testing](command:workbench.view.testing.focus)",
            "media": {
              "markdown": "media/walkthrough/test.md"
            },
            "completionEvents": [
              "onCommand:workbench.view.testing.focus"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "cd ../.. && bun run build",
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node22 --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "esbuild test/integration/index.ts --bundle --platform=node --target=node22 --format=cjs --external:vscode --outfile=dist-test/index.js",
    "test:integration": "bun run build && bun run build:test && bun test/integration/runner.ts",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@elide/ide-core": "workspace:*"
