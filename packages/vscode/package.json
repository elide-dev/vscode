{
  "name": "elide",
  "displayName": "Elide",
  "description": "Elide build tool integration: Kotlin/Java classpath for the Kotlin LSP, build/run/test tasks, and JDWP debugging.",
  "version": "0.2.0",
  "preview": true,
  "publisher": "elide",
  "author": "Elide Technologies, Inc.",
  "license": "MIT",
  "private": true,
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0F0F0F",
    "theme": "dark"
  },
  "homepage": "https://github.com/elide-dev/vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/elide-dev/vscode.git"
  },
  "bugs": {
    "url": "https://github.com/elide-dev/vscode/issues"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Testing",
    "Other"
  ],
  "keywords": [
    "elide",
    "kotlin",
    "java",
    "jvm",
    "build",
    "build tool",
    "kotlin lsp",
    "pkl"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Syncing a project runs the workspace's Elide CLI (`elide manifest`, `elide install`, `elide classpath`), so an untrusted workspace could execute arbitrary code."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The Elide CLI, the JDK, and the generated `workspace.json` all need a real filesystem."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "JetBrains.kotlin-server"
  ],
  "activationEvents": [
    "workspaceContains:**/elide.pkl",
    "onDebugResolve:elide",
    "onTaskType:elide",
    "onView:elide.projects"
  ],
  "contributes": {
    "configuration": {
      "title": "Elide",
      "properties": {
        "elide.home": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Elide distribution root (the directory containing `bin/elide`). Empty: use `$ELIDE_HOME`, the platform install locations, then `elide` on `PATH`."
        },
        "elide.jdk.home": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "JDK home used for symbol resolution in the Kotlin LSP. Empty: `jvm.javaHome` from the manifest, then `$JAVA_HOME`, then installed JDKs (SDKMAN, /Library/Java/JavaVirtualMachines, /usr/lib/jvm, Program Files) matching `jvm.target`."
        },
        "elide.sync.onStartup": {
          "type": "boolean",
          "default": true,
          "description": "Sync Elide projects when the workspace opens."
        },
        "elide.sync.onManifestChange": {
          "type": "string",
          "enum": ["always", "prompt", "never"],
          "default": "prompt",
          "description": "What to do when elide.pkl or the lockfile changes."
        },
        "elide.kotlinLsp.writeWorkspaceJson": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Write `workspace.json` at the workspace folder root so the Kotlin LSP imports the Elide project model."
        },
        "elide.debug.adapter": {
          "type": "string",
          "enum": ["intellij", "java"],
          "enumDescriptions": [
            "Attach with the Kotlin LSP's JVM debugger (JetBrains.kotlin-server).",
            "Attach with Debugger for Java (vscjava.vscode-java-debug)."
          ],
          "default": "intellij",
          "description": "Debug adapter used to attach to the JVM started by `elide run --debugger`."
        },
        "elide.install.classifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["sources", "docs"]
          },
          "default": ["sources"],
          "uniqueItems": true,
          "markdownDescription": "Classifier jars installed for the manifest's declared Maven packages. `sources` lets Go to Definition open library code in the Kotlin LSP; `docs` adds javadoc jars; an empty list installs classes only. Elide's own Kotlin and JUnit jars are published without classifiers."
        },
        "elide.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Run/Debug code lenses above JVM main functions and on entrypoints, scripts and artifacts in elide.pkl."
        }
      }
    },
    "commands": [
      {
        "command": "elide.sync",
        "category": "Elide",
        "title": "Sync Project(s)",
        "icon": "$(sync)"
      },
      {
        "command": "elide.showOutput",
        "category": "Elide",
        "title": "Show Output"
      },
      {
        "command": "elide.showMenu",
        "category": "Elide",
        "title": "Show Menu",
        "icon": "$(list-unordered)"
      },
      {
        "command": "elide.openWorkspaceJson",
        "category": "Elide",
        "title": "Open generated Kotlin LSP workspace"
      },
      {
        "command": "elide.runTask",
        "category": "Elide",
        "title": "Run Elide Command…",
        "icon": "$(play)"
      },
      {
        "command": "elide.run",
        "category": "Elide",
        "title": "Run Entrypoint",
        "icon": "$(play)"
      },
      {
        "command": "elide.debug",
        "category": "Elide",
        "title": "Debug Entrypoint",
        "icon": "$(debug-alt)"
      },
      {
        "command": "elide.build",
        "category": "Elide",
        "title": "Build Artifact",
        "icon": "$(package)"
      },
      {
        "command": "elide.executeTask",
        "category": "Elide",
        "title": "Run Task",
        "icon": "$(play)"
      },
      {
        "command": "elide.openManifest",
        "category": "Elide",
        "title": "Open elide.pkl",
        "icon": "$(file-code)"
      },
      {
        "command": "elide.revealLibrary",
        "category": "Elide",
        "title": "Reveal in Finder/Explorer"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "elide.run",
          "when": "false"
        },
        {
          "command": "elide.debug",
          "when": "false"
        },
        {
          "command": "elide.build",
          "when": "false"
        },
        {
          "command": "elide.executeTask",
          "when": "false"
        },
        {
          "command": "elide.revealLibrary",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "elide.sync",
          "when": "view == elide.projects",
          "group": "navigation@1"
        },
        {
          "command": "elide.runTask",
          "when": "view == elide.projects",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "elide.run",
          "when": "view == elide.projects && viewItem == entrypoint",
          "group": "inline@1"
        },
        {
          "command": "elide.debug",
          "when": "view == elide.projects && viewItem == entrypoint",
          "group": "inline@2"
        },
        {
          "command": "elide.run",
          "when": "view == elide.projects && viewItem == script",
          "group": "inline@1"
        },
        {
          "command": "elide.executeTask",
          "when": "view == elide.projects && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "elide.executeTask",
          "when": "view == elide.projects && viewItem == buildTarget",
          "group": "inline@1"
        },
        {
          "command": "elide.sync",
          "when": "view == elide.projects && viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "elide.openManifest",
          "when": "view == elide.projects && viewItem == project",
          "group": "inline@2"
        },
        {
          "command": "elide.revealLibrary",
          "when": "view == elide.projects && viewItem == library"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "elide",
          "title": "Elide",
          "icon": "media/elide.svg"
        }
      ]
    },
    "views": {
      "elide": [
        {
          "id": "elide.projects",
          "name": "Projects",
          "contextualTitle": "Elide",
          "icon": "media/elide.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "elide.projects",
        "when": "!elide.hasProjects",
        "contents": "No Elide project (`elide.pkl`) in this workspace.\n[Open Folder](command:vscode.openFolder)\n[Elide documentation](https://docs.elide.dev)"
      }
    ],
    "problemMatchers": [
      {
        "name": "elide",
        "label": "Elide build diagnostics",
        "owner": "elide",
        "source": "elide",
        "fileLocation": [
          "search",
          {
            "include": ["${workspaceFolder}"],
            "exclude": ["${workspaceFolder}/.dev", "${workspaceFolder}/.git", "${workspaceFolder}/node_modules"]
          }
        ],
        "pattern": [
          {
            "regexp": "^(?:\\[\\s*[^\\]]+\\]\\s?)?(error|warning|info):\\s+(?:\\[\\w+\\]\\s*)?(?:[\\w.+-]+:\\s+)?(.*)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^In file:\\s+(?:file://)?(\\S+?)(?::(\\d+))?(?::(\\d+))?\\s*$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "elide",
        "required": ["command"],
        "properties": {
          "command": {
            "type": "string",
            "enum": ["build", "run", "test", "install"],
            "description": "Elide CLI command to run."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional arguments passed after the command."
          },
          "project": {
            "type": "string",
            "description": "Project root relative to the workspace folder (multi-project workspaces)."
          }
        }
      }
    ],
    "breakpoints": [
      {
        "language": "kotlin"
      },
      {
        "language": "java"
      }
    ],
    "debuggers": [
      {
        "type": "elide",
        "label": "Elide",
        "languages": ["kotlin", "java"],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "entrypoint": {
                "type": "string",
                "description": "Entrypoint file, manifest script name, or empty to let Elide resolve `entrypoint`/`jvm.main`."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments passed to the program after `--`."
              },
              "project": {
                "type": "string",
                "description": "Project root relative to the workspace folder (multi-project workspaces)."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra environment variables for the Elide process."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "elide",
            "request": "launch",
            "name": "Elide: Run (debug)"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Elide: Run (debug)",
            "description": "Run the project's entrypoint with `elide run --debugger` and attach.",
            "body": {
              "type": "elide",
              "request": "launch",
              "name": "Elide: Run (debug)"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "cd ../.. && bun run build",
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node22 --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "esbuild test/integration/index.ts --bundle --platform=node --target=node22 --format=cjs --external:vscode --outfile=dist-test/index.js",
    "test:integration": "bun run build && bun run build:test && bun test/integration/runner.ts",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@elide/ide-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.105.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
