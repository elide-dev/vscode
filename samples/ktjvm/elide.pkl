amends "elide:project.pkl"
import "elide:Sources.pkl" as Sources
import "versions.pkl"

name = "ktjvm-sample"

jvm {
    main = "sample.MainKt"
}

sources {
    ["main"] = new Sources.SourceSetSpec {
        paths {
            "src/main/**/*.kt"
        }
    }
    ["test"] = "src/test/**/*.kt"
}

dependencies {
    maven {
        packages {
            "com.google.guava:guava:\(versions.guava)"
        }
    }
}
