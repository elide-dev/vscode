"""Elide VS Code extension: `@elide/ide-core` (packages/core) and the extension (packages/vscode)."""

module(name = "elide_vscode")

bazel_dep(name = "aspect_rules_esbuild", version = "0.27.1")
bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_nodejs", version = "6.7.6")

bazel_dep(name = "aspect_gazelle_prebuilt", version = "0.0.27", dev_dependency = True)

# Node runs tsc, esbuild's launcher, vsce and the integration-test driver. 22 is the Node line of the Electron that
# VS Code ^1.105 ships, and the `node22` esbuild target below.
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.22.0")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(pnpm_version_from = "//:package.json")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    # Bazel re-locks (`pnpm install --lockfile-only`) when any of these change; CI only verifies (see .bazelrc).
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
        "//packages/core:package.json",
        "//packages/vscode:package.json",
    ],
    pnpm_lock = "//:pnpm-lock.yaml",
    # vsce's secret scan loads its rule and formatter packages by name from `@secretlint/*` packages that do not depend
    # on them: it relies on a hoisted node_modules. Link them at the root, where those lookups end up.
    public_hoist_packages = {
        "@secretlint/secretlint-formatter-sarif": [""],
        "@secretlint/secretlint-rule-no-dotenv": [""],
        "@secretlint/secretlint-rule-preset-recommend": [""],
    },
    update_pnpm_lock = True,
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(version_from = "//:package.json")
use_repo(typescript, "npm_typescript")

esbuild = use_extension("@aspect_rules_esbuild//esbuild:extensions.bzl", "esbuild")
esbuild.toolchain(
    name = "esbuild",
    esbuild_version = "0.25.11",
)
use_repo(esbuild, "esbuild_toolchains")

register_toolchains("@esbuild_toolchains//:all")

bun = use_extension("//tools/bazel/bun:extensions.bzl", "bun")
use_repo(bun, "bun_darwin_aarch64", "bun_darwin_x64", "bun_linux_aarch64", "bun_linux_x64")
